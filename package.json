{
  "name": "optikpi_v2.0_smoketest_automation",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "postinstall": "node scripts/patch-templates.js",
    "clean": "rimraf reports/extent reports/screenshots reports/json data/.user-locks data/auth",
    "pretest": "npm run clean",
    "test": "cucumber-js -c config/cucumber.js",
    "pretest:tag": "rimraf data/.user-locks data/auth",
    "test:tag": "cucumber-js -c config/cucumber.js --tags",
    "test:serial": "cross-env PARALLEL_THREADS=1 npm test",
    "test:screenshots": "cross-env STEP_SCREENSHOTS=always SCENARIO_SCREENSHOTS=always npm test",
    "test:extent": "npm run test:serial",
    "test:parallel": "node src/runner/runner.js --groups",
    "test:parallel:continue": "node src/runner/runner.js --groups --continue-on-fail",
    "test:parallel:dry-run": "node src/runner/runner.js --groups --dry-run",
    "test:parallel:sorted": "node src/runner/runner.js --groups --continue-on-fail && node scripts/sort-report.js",
    "report:sorted": "node scripts/sort-report.js",
    "slack:report": "node scripts/slack-report.js",
    "cleanup": "node scripts/cleanup-test-data.js",
    "cleanup:dry-run": "node scripts/cleanup-test-data.js --dry-run",
    "casino:register": "ts-node src/utils/run-casino-api.ts register",
    "casino:login": "ts-node src/utils/run-casino-api.ts login",
    "casino:logout": "ts-node src/utils/run-casino-api.ts logout",
    "casino:deposit": "ts-node src/utils/run-casino-api.ts deposit",
    "casino:session": "ts-node src/utils/run-casino-api.ts session",
    "casino:all": "ts-node src/utils/run-casino-api.ts all"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "@cucumber/cucumber": "^12.5.0",
    "@slack/web-api": "^7.14.1",
    "dotenv": "^17.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@types/cucumber": "^7.0.0",
    "@types/node": "^22.13.1",
    "cross-env": "^10.1.0",
    "cucumber-js-extent": "^0.1.0",
    "playwright": "^1.58.2",
    "rimraf": "^6.1.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.3"
  }
}
